import * as THREE from 'three';
import { toLocal } from '../world/geo.js';
import { createModel } from '../world/models.js';
import { keepVisible, makeLabel, setInfo } from '../world/markers.js';
import { SHARED } from '../world/shading.js';

// Atmospheric selection of lighthouse sites around Tokyo Bay and its approaches.
// Coordinates are WGS84 decimal degrees (longitude, latitude).
// Published characteristics are recorded where available; rendering details
// and flash durations are approximations where official sources do not specify them.
const SITES = [
  {
    id: 'kannonzaki',
    name: 'Kannonzaki Lighthouse',
    label: 'KANNONZAKI',
    lon: 139.74528,
    lat: 35.25611,
    lampHeight: 17.2,
    range: 19,
    description:
      "Japan's first Western-style lighthouse at the Uraga Channel entrance to Tokyo Bay.",
    light: 'Fl(2) W 15s — two white flashes every 15 seconds',
    rotationPeriod: 15,
    flashPeriod: 15,
    flashPattern: [
      [0.00, 0.018, 0xffffff],
      [0.075, 0.093, 0xffffff],
    ],
    phaseOffset: 0.1,
    color: 0xffffff,
    beamLength: 2600,
    beamRadius: 85,
    beamIntensity: 0.48,
    dataSource: 'Japan Coast Guard / MLIT',
  },
  {
    id: 'nojimazaki',
    name: 'Nojimazaki Lighthouse',
    label: 'NOJIMAZAKI',
    lon: 139.88600,
    lat: 34.90100,
    lampHeight: 29,
    range: 17,
    description:
      'Lighthouse at the southern tip of the Boso Peninsula, near the Pacific approach to Tokyo Bay.',
    light: 'Fl W 15s — one white flash every 15 seconds',
    rotationPeriod: 15,
    flashPeriod: 15,
    flashPattern: [[0.00, 0.018, 0xffffff]],
    phaseOffset: 2.2,
    color: 0xffffff,
    beamLength: 3000,
    beamRadius: 92,
    beamIntensity: 0.46,
    dataSource: 'Japan Coast Guard, Chiba Coast Guard Office',
  },
  {
    id: 'sunosaki',
    name: 'Sunosaki Lighthouse',
    label: 'SUNOSAKI',
    lon: 139.76200,
    lat: 34.97600,
    lampHeight: 45,
    range: 18.5,
    description:
      'Lighthouse at the western tip of the Boso Peninsula, marking the Tokyo Bay and Pacific transition.',
    light: 'Fl W/R 30s — alternating white and red flashes in a 30-second cycle',
    rotationPeriod: 30,
    flashPeriod: 30,
    flashPattern: [
      [0.00, 0.012, 0xffffff],
      [0.50, 0.512, 0xff3030],
    ],
    phaseOffset: 4.4,
    color: 0xffffff,
    beamLength: 3200,
    beamRadius: 94,
    beamIntensity: 0.46,
    dataSource: 'Japan Coast Guard, Chiba Coast Guard Office',
  },
  {
    id: 'tsurugisaki',
    name: 'Tsurugisaki Lighthouse',
    label: 'TSURUGISAKI',
    lon: 139.67650,
    lat: 35.13600,
    lampHeight: 17,
    range: 12,
    description:
      'Lighthouse on the southeastern Miura Peninsula, near the Tokyo Bay entrance approaches.',
    light: 'Fl(2) W/G 30s — published flash grouping and colors require verification',
    rotationPeriod: 30,
    flashPeriod: 30,
    flashPattern: [
      [0.00, 0.012, 0xffffff],
      [0.055, 0.067, 0xffffff],
      [0.11, 0.122, 0x35ff8a],
    ],
    phaseOffset: 1.7,
    color: 0xffffff,
    beamLength: 2500,
